{
  "name": "scratchpiler",
  "version": "1.0.0",
  "description": "A text-based DSL that compiles directly into Scratch's block VM. Because sometimes you want to write a platformer without playing Tetris with puzzle pieces, or because you've finally realized that dragging colorful plastic shapes with a mouse is a slow descent into developer madness.",
  "main": "scratchpiler.user.js",
  "bin": {
    "scratchpiler": "./cli/scratchpiler.js"
  },
  "directories": {
    "doc": "docs",
    "example": "examples"
  },
  "scripts": {
    "test": "node --test tests/*.test.js && npm run test:slvm",
    "cli": "node cli/scratchpiler.js",
    "build": "node build.js",
    "dev": "node build.js --watch",
    "prod": "node build.js --prod",
    "check": "npm test && npm run prod",
    "slopt": "slopt",
    "slc": "slc",
    "setup": "npm ci",
    "test:slvm": "npm --prefix node_modules/slvm test"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/Scratchpiler/scratchpiler.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Scratchpiler/scratchpiler/issues"
  },
  "homepage": "https://github.com/Scratchpiler/scratchpiler#readme",
  "devDependencies": {
    "esbuild": "^0.28.1",
    "jsdom": "^30.1.1",
    "scratch-vm": "^5.0.300"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "dependencies": {
    "slvm": "git+https://github.com/Scratchpiler/slvm.git#a3f4fcaa2254af4207197d5ddf768802f0b51867"
  }
}
